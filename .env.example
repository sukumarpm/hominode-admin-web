# Public web configuration only. Never add service-account keys.
# All three values are required in production and local development.
# Copy to .env.local and supply the values for this Firebase Web app.
# Missing or blank values stop authentication initialization; there are no fallbacks.
VITE_FIREBASE_API_KEY=
# Existing Admin Web app identity.
VITE_FIREBASE_APP_ID=1:551984029668:web:5845083359a375d90db1f1
# Enterprise reCAPTCHA site key configured for this app's domains.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# App Check debug mode is enabled only by Vite's built-in DEV flag.
# No VITE_APPCHECK_DEBUG production switch is supported.
